    "tslib": "^2.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2"
