node_modules/
dist/
*.local
.DS_Store
.vite/
coverage/

# Never commit real signed documents or private keys — PAdES fixtures are
# generated by `npm run fixtures:pades` instead.
*.p12
*.pfx
*.key

# Real documents brought in for testing land at the repo root. They carry
# personal data and must stay out of the repo; reproduce what they taught us as
# a generated fixture instead (see app/src/lib/fixtures/README.md). Fixtures
# live under app/, so this rule cannot catch them by accident.
/*.pdf
/*.odt
/*.ots

# Operational handoff notes dropped in by hand. This repo is public; the
# operator's name, the Cloudflare split and the deploy process do not belong in
# it. Whatever is durable from them lives in CLAUDE.md and docs/next-session.md.
MILAN-AGENT-INSTRUCTIONS.md
